---
import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout title="About | Zeyad Alghannam" description="About Zeyad Alghannam - Game Developer and Computer Science graduate from Majmaah University specializing in 2D game development">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="About"
				tagline="Thanks for stopping by. Read below to learn more about my journey in game development and my background in computer science."
			>
				<img
					width="1553"
					height="873"
					src="/assets/at-work.jpg"
					alt="Zeyad Alghannam - Game Developer and Computer Science Graduate"
				/>
			</Hero>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>
						I am Zeyad Alghannam, a passionate Game Developer and recent Computer Science graduate from Majmaah University. My journey in game development began with a curiosity for creating interactive experiences and has evolved into a focused expertise in 2D game development using Unity and Game Maker Studio.
					</p>
					<p>
						Graduating in May 2024, I've developed a strong foundation in programming fundamentals while specializing in game development technologies. My experience spans from designing gameplay mechanics to building responsive UI systems and implementing dialogue systems that enhance player engagement.
					</p>
					<p>
						I'm currently participating in a game jam (May 2025) and actively working on innovative dialogue and discussion systems. My portfolio showcases multiple 2D games that demonstrate my ability to create polished, user-focused experiences with emphasis on gameplay mechanics and player interaction.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Education & Experience</h2>
				<div class="content">
					<p>
						<strong>Bachelor of Computer Science</strong> - Majmaah University (Graduated May 2024)
					</p>
					<p>
						<strong>Unity Game Development Graduate</strong> - Tuwaiq Academy
					</p>
					<p>
						<strong>Trainee at Boeing</strong> (2024) - Participated in structured technical training and collaborative problem-solving, strengthening my programming and professional skills in a corporate setting.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Skills & Expertise</h2>
				<div class="content">
					<p>
						<strong>Game Engines:</strong> Unity, Game Maker Studio - Proficient in both engines for 2D game development, with experience in creating complete game experiences from concept to final product.
					</p>
					<p>
						<strong>Programming Languages:</strong> C#, Game Maker Language (GML) - Strong foundation in both languages for game logic, UI systems, and interactive mechanics.
					</p>
					<p>
						<strong>Focus Areas:</strong> 2D Game Development, UI Systems, Dialogue Systems, Input Handling, Prototyping - Specialized in creating engaging 2D experiences with polished user interfaces and smooth player interactions.
					</p>
					<p>
						<strong>Portfolio:</strong> Multiple games available on <a href="https://zeyadalghannam.itch.io" target="_blank" rel="noopener">itch.io</a> showcasing various genres and mechanics.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Recent Achievements</h2>
				<div class="content">
					<p>
						<strong>Game Jam Achievement:</strong> Placed 81st out of over 1,000 games in my first game jam.
					</p>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
